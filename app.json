{
  "expo": {
    "name": "Geko",
    "slug": "geko",
    "version": "1.0.0",
    "sdkVersion": "51.0.0",
    "icon": "./assets/images/Geko.png",
    "splash": {
      "image": "./assets/images/splash_blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#16A06B"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "android": {
      "package": "com.me.geko",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/geko_adaptive_foreground.png",
        "backgroundColor": "#16A06B"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "./withGekoNativeConfig.js",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.me.geko"
    },
    "extra": {
      "eas": {
        "projectId": "601a56f1-65f0-4d56-8516-6cf74bd957e1"
      }
    }
  }
}
