{
  "expo": {
    "name": "Geko",
    "slug": "geko",
    "version": "1.0.0",
    "sdkVersion": "51.0.0",
    "icon": "./assets/images/Geko.png",
    "splash": {
      "image": "./assets/images/Geko.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "android": {
      "package": "com.me.geko",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "./withGekoNativeConfig.js",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.me.geko"
    }
  }
}
