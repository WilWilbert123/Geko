{
  "expo": {
    "name": "Geko",
    "slug": "geko",
    "version": "1.0.5",
    "sdkVersion": "51.0.0",
    "icon": "./assets/images/Geko.png",
    "splash": {
      "image": "./assets/images/splash_blank.png",
      "resizeMode": "contain",
      "backgroundColor": "#16A06B"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "android": {
      "package": "com.gekobudgettracker.app",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/geko_adaptive_foreground.png",
        "backgroundColor": "#16A06B"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "./withGekoNativeConfig.js",
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false,
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.gekobudgettracker.app"
    },
    "extra": {
      "eas": {
        "projectId": "601a56f1-65f0-4d56-8516-6cf74bd957e1"
      }
    }
  }
}
